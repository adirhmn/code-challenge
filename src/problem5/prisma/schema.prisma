datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String
  price       Float
  category    String   // ELECTRONICS, CLOTHING, HOME, BOOKS, BEAUTY, SPORTS
  status      String   @default("ACTIVE") // DRAFT, ACTIVE, OUT_OF_STOCK, ARCHIVED
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
